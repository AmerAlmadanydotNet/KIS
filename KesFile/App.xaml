<Application
    x:Class="KesFile.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:KesFile.Converters"
    RequestedTheme="Light">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ─── Converters ─────────────────────────────────────────────── -->
            <conv:BoolToVisibilityConverter        x:Key="BoolToVisibleConverter"/>
            <conv:BoolNegateConverter              x:Key="BoolNegateConverter"/>
            <conv:ZeroToVisibilityConverter        x:Key="ZeroToVisibleConverter"/>
            <conv:NonZeroToVisibilityConverter     x:Key="NonZeroToVisibleConverter"/>
            <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVisibleConverter"/>
            <conv:StorageItemGlyphConverter            x:Key="StorageItemGlyphConverter"/>

            <!-- ─── App accent colour (blue) ──────────────────────────────── -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#5064D4"/>

            <!-- ─── Page background ────────────────────────────────────────── -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F7FF"/>

            <!-- ─── Accent button style (self-contained, no WinUI2 needed) ── -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#5064D4"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,6"/>
            </Style>

            <!-- ─── Large title text style ────────────────────────────────── -->
            <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
