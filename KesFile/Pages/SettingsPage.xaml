<Page
    x:Class="KesFile.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" Spacing="24">
            <TextBlock Text="Settings"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Foreground="#1A1A2E"/>

            <!-- Defaults -->
            <Border Background="White" CornerRadius="12"
                    BorderBrush="#E5E7EB" BorderThickness="1" Padding="24,20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Default Compression"
                               FontWeight="SemiBold" FontSize="15" Foreground="#1A1A2E"/>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Algorithm" Foreground="#4B5563" FontSize="13"/>
                        <ComboBox HorizontalAlignment="Stretch" CornerRadius="8"
                                  SelectedIndex="1">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="LZMA (recommended)"/>
                            <ComboBoxItem Content="Deflate"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Background="White" CornerRadius="12"
                    BorderBrush="#E5E7EB" BorderThickness="1" Padding="24,20">
                <StackPanel Spacing="10">
                    <TextBlock Text="About KIS file"
                               FontWeight="SemiBold" FontSize="15" Foreground="#1A1A2E"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="KIS file v1.0" Foreground="#4B5563"/>
                        <TextBlock Text="Format: .kes" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="Compression: LZMA (SharpCompress) / Deflate" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="Encryption: AES-256-CBC + HMAC-SHA256" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="Key derivation: PBKDF2-SHA256 (600,000 iterations)" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="Integrity: SHA-256 per-file checksums" Foreground="#6B7280" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
