<Page
    x:Class="KesFile.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,40,40,40" Spacing="28">

            <!-- Hero Banner -->
            <Border Background="#F0F4FF" CornerRadius="16" Padding="40,32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="KIS file Archiver"
                                   Style="{StaticResource TitleLargeTextBlockStyle}"
                                   Foreground="#1A1A2E" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" MaxWidth="520"
                                   Foreground="#4A4A6A" FontSize="15">
                            <Run Text="Secure, fast, and smarter than ZIP. KIS file uses "/>
                            <Run Text="LZMA compression" FontWeight="SemiBold"/>
                            <Run Text=" + "/>
                            <Run Text="AES-256 encryption" FontWeight="SemiBold"/>
                            <Run Text=" with PBKDF2 key derivation — keeping your files private and compact."/>
                        </TextBlock>
                    </StackPanel>
                    <!-- Icon -->
                    <Border Grid.Column="1" Width="80" Height="80"
                            Background="#E8EDFF" CornerRadius="20"
                            Margin="24,0,0,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="#5064D4"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Quick Action Cards -->
            <TextBlock Text="Quick Actions"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,4"/>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Create Card -->
                <Button Grid.Column="0" x:Name="CreateCard"
                        HorizontalAlignment="Stretch"
                        Padding="0" CornerRadius="12"
                        Click="CreateCard_Click">
                    <Border Background="White" CornerRadius="12" Padding="28,24"
                            BorderBrush="#E0E5F7" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Border Width="52" Height="52" CornerRadius="14"
                                    Background="#EEF2FF" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE710;" FontSize="26" Foreground="#5064D4"/>
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Create Archive"
                                           FontWeight="SemiBold" FontSize="17"
                                           Foreground="#1A1A2E"/>
                                <TextBlock Text="Compress and optionally encrypt files into a .kes archive"
                                           TextWrapping="Wrap" Foreground="#6B7280" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Open Card -->
                <Button Grid.Column="1" x:Name="OpenCard"
                        HorizontalAlignment="Stretch"
                        Padding="0" CornerRadius="12"
                        Click="OpenCard_Click">
                    <Border Background="White" CornerRadius="12" Padding="28,24"
                            BorderBrush="#E0E5F7" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Border Width="52" Height="52" CornerRadius="14"
                                    Background="#FFF3E0" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8DA;" FontSize="26" Foreground="#F57C00"/>
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Open Archive"
                                           FontWeight="SemiBold" FontSize="17"
                                           Foreground="#1A1A2E"/>
                                <TextBlock Text="Browse and extract files from an existing .kes archive"
                                           TextWrapping="Wrap" Foreground="#6B7280" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>

            <!-- Drop Zone -->
            <Border x:Name="DropZoneBorder"
                    Background="White" CornerRadius="12"
                    BorderBrush="#C7D2FE" BorderThickness="2"
                    Padding="40,36"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE91C;" FontSize="48" Foreground="#A5B4FC"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop files here to create an archive"
                               HorizontalAlignment="Center"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#6B7280"/>
                    <TextBlock Text="Supports any file type"
                               HorizontalAlignment="Center"
                               FontSize="13" Foreground="#9CA3AF"/>
                </StackPanel>
            </Border>

            <!-- Advantages -->
            <TextBlock Text="Why KIS file is better than ZIP"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,8,0,4"/>

            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- Advantage rows -->
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#E5E7EB" BorderThickness="1" Padding="20,14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="20" Foreground="#10B981" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="AES-256 Encryption + PBKDF2 (600k iterations)"
                                       FontWeight="SemiBold" Foreground="#1A1A2E"/>
                            <TextBlock Text="ZIP's encryption is easily cracked. KIS file uses military-grade key derivation."
                                       TextWrapping="Wrap" Foreground="#6B7280" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="10"
                        BorderBrush="#E5E7EB" BorderThickness="1" Padding="20,14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="20" Foreground="#6366F1" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="LZMA Compression — 30–50 % better ratio than Deflate"
                                       FontWeight="SemiBold" Foreground="#1A1A2E"/>
                            <TextBlock Text="Uses the same algorithm as 7-Zip's .7z format for smaller output."
                                       TextWrapping="Wrap" Foreground="#6B7280" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="10"
                        BorderBrush="#E5E7EB" BorderThickness="1" Padding="20,14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="20" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="SHA-256 Per-File Integrity Checksums"
                                       FontWeight="SemiBold" Foreground="#1A1A2E"/>
                            <TextBlock Text="ZIP uses only CRC-32 which is not cryptographically secure."
                                       TextWrapping="Wrap" Foreground="#6B7280" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="10"
                        BorderBrush="#E5E7EB" BorderThickness="1" Padding="20,14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8ED;" FontSize="20" Foreground="#EC4899" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Encrypted Filenames — Archive Opaque to Scanners"
                                       FontWeight="SemiBold" Foreground="#1A1A2E"/>
                            <TextBlock Text="Optionally encrypt file paths so no metadata is revealed to external tools."
                                       TextWrapping="Wrap" Foreground="#6B7280" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="10"
                        BorderBrush="#E5E7EB" BorderThickness="1" Padding="20,14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8F4;" FontSize="20" Foreground="#14B8A6" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Split Archive Support"
                                       FontWeight="SemiBold" Foreground="#1A1A2E"/>
                            <TextBlock Text="Split large archives into smaller parts for easy storage or transfer."
                                       TextWrapping="Wrap" Foreground="#6B7280" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
