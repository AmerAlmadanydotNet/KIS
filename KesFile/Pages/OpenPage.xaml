<Page
    x:Class="KesFile.Pages.OpenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KesFile.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32,40,16" Spacing="24">

                <!-- Title + Open button -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Open Archive"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="#1A1A2E"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Click="Browse_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="8"/>
                </Grid>

                <!-- Archive info banner -->
                <Border x:Name="ArchiveInfoBanner"
                        Background="#F0F7FF"
                        CornerRadius="12"
                        BorderBrush="#BAD0F8" BorderThickness="1"
                        Padding="20,14"
                        Visibility="{x:Bind ViewModel.ArchiveInfo, Mode=OneWay, Converter={StaticResource NonEmptyToVisibleConverter}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ArchiveName, Mode=OneWay}"
                                   FontWeight="SemiBold" FontSize="15" Foreground="#1A1A2E"/>
                        <TextBlock Text="{x:Bind ViewModel.ArchiveInfo, Mode=OneWay}"
                                   Foreground="#4B5563" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Password unlock panel (shown only for encrypted archives) -->
                <Border x:Name="PasswordPanel"
                        Background="#FFF8F0"
                        CornerRadius="12"
                        BorderBrush="#FBD38D" BorderThickness="1"
                        Padding="20,16"
                        Visibility="{x:Bind ViewModel.IsEncrypted, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE72E;"
                                      FontSize="22" Foreground="#D97706"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="This archive is encrypted. Enter the password to unlock."
                                       TextWrapping="Wrap"
                                       Foreground="#92400E" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.PasswordHint, Mode=OneWay}"
                                   Foreground="#B45309" FontSize="12" FontStyle="Italic"
                                   Visibility="{x:Bind ViewModel.PasswordHint, Mode=OneWay, Converter={StaticResource NonEmptyToVisibleConverter}}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0"
                                         PlaceholderText="Enter password"
                                         Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                                         CornerRadius="8"/>
                            <Button Grid.Column="1"
                                    Content="Unlock"
                                    Click="Unlock_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    CornerRadius="8"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status message -->
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Foreground="#EF4444" FontSize="13"
                           Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NonEmptyToVisibleConverter}}"
                           TextWrapping="Wrap"/>

                <!-- File list -->
                <Border Background="White" CornerRadius="12"
                        BorderBrush="#E5E7EB" BorderThickness="1"
                        Visibility="{x:Bind ViewModel.Entries.Count, Mode=OneWay, Converter={StaticResource NonZeroToVisibleConverter}}">
                    <StackPanel>
                        <!-- Column headers -->
                        <Grid Background="#F9FAFB" Padding="20,10"
                              CornerRadius="12,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Name"
                                       Foreground="#6B7280" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Original"
                                       Foreground="#6B7280" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Stored"
                                       Foreground="#6B7280" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Ratio"
                                       Foreground="#6B7280" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="Modified"
                                       Foreground="#6B7280" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Entry rows -->
                        <ListView x:Name="EntryListView"
                                  ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                                  SelectionMode="Extended"
                                  MaxHeight="420"
                                  Padding="0,4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArchiveEntryViewModel">
                                    <Grid Padding="20,8" ColumnSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  Glyph="{x:Bind TypeIcon}"
                                                  FontSize="16" Foreground="#6366F1"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Path}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind OriginalSize}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#4B5563" FontSize="13"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind StoredSize}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#4B5563" FontSize="13"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{x:Bind CompressionRatio}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#10B981" FontSize="13"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="{x:Bind Modified}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#4B5563" FontSize="13"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom action bar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                Padding="40,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Progress -->
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                 Maximum="100"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                 CornerRadius="4"/>
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                               Foreground="#6B7280" FontSize="13"
                               Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Button Content="Extract Selected"
                            Click="ExtractSelected_Click"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegateConverter}}"
                            Visibility="{x:Bind ViewModel.Entries.Count, Mode=OneWay, Converter={StaticResource NonZeroToVisibleConverter}}"
                            CornerRadius="10" Padding="20,10"/>
                    <Button Content="Extract All"
                            Click="ExtractAll_Click"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegateConverter}}"
                            Visibility="{x:Bind ViewModel.Entries.Count, Mode=OneWay, Converter={StaticResource NonZeroToVisibleConverter}}"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="10" Padding="20,10"
                            FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
