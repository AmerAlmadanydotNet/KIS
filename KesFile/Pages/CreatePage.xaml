<Page
    x:Class="KesFile.Pages.CreatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32,40,16" Spacing="24">

                <!-- Page title -->
                <TextBlock Text="Create Archive"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Foreground="#1A1A2E"/>

                <!-- Files section -->
                <Border Background="White" CornerRadius="12"
                        BorderBrush="#E5E7EB" BorderThickness="1"
                        Padding="24,20"
                        AllowDrop="True"
                        DragOver="DropZone_DragOver"
                        Drop="DropZone_Drop">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Files &amp; Folders to Compress"
                                       FontWeight="SemiBold" FontSize="15"
                                       VerticalAlignment="Center" Foreground="#1A1A2E"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddFilesButton"
                                        Content="Add Files"
                                        Click="AddFiles_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        CornerRadius="8"/>
                                <Button x:Name="AddFolderButton"
                                        Content="Add Folder"
                                        Click="AddFolder_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        CornerRadius="8"/>
                                <Button Content="Clear All"
                                        Click="ClearFiles_Click"
                                        CornerRadius="8"/>
                            </StackPanel>
                        </Grid>

                        <!-- Drop hint -->
                        <Border x:Name="FileDropHint"
                                Background="#F8FAFF" CornerRadius="8"
                                BorderBrush="#C7D2FE" BorderThickness="1"
                                Padding="16,12"
                                Visibility="{x:Bind ViewModel.FilesToCompress.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibleConverter}}">
                            <TextBlock Text="Drop files or folders here, or click 'Add Files' / 'Add Folder'"
                                       HorizontalAlignment="Center"
                                       Foreground="#9CA3AF" FontSize="14"/>
                        </Border>

                        <!-- File list -->
                        <ListView x:Name="FileListView"
                                  ItemsSource="{x:Bind ViewModel.FilesToCompress, Mode=OneWay}"
                                  MaxHeight="220"
                                  Visibility="{x:Bind ViewModel.FilesToCompress.Count, Mode=OneWay, Converter={StaticResource NonZeroToVisibleConverter}}"
                                  SelectionMode="Extended">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  Glyph="{Binding Converter={StaticResource StorageItemGlyphConverter}}"
                                                  FontSize="18" Foreground="#6366F1"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2"
                                                Tag="{Binding}"
                                                Click="RemoveItem_Click"
                                                Padding="6,4" CornerRadius="6">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#EF4444"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- File count -->
                        <TextBlock Foreground="#6B7280" FontSize="12">
                            <Run Text="{x:Bind ViewModel.FilesToCompress.Count, Mode=OneWay}"/>
                            <Run Text=" item(s) selected"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Options section (two columns) -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Compression options -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12"
                            BorderBrush="#E5E7EB" BorderThickness="1" Padding="24,20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Compression"
                                       FontWeight="SemiBold" FontSize="15" Foreground="#1A1A2E"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Algorithm" Foreground="#4B5563" FontSize="13"/>
                                <ComboBox x:Name="AlgorithmCombo"
                                          SelectedIndex="{x:Bind ViewModel.CompressionAlgorithmIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="8">
                                    <ComboBoxItem Content="None"/>
                                    <ComboBoxItem Content="LZMA (best ratio — recommended)"/>
                                    <ComboBoxItem Content="Deflate (fast)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Compression Level"
                                               Foreground="#4B5563" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind GetLevelText(ViewModel.CompressionSpeedIndex), Mode=OneWay}"
                                               Foreground="#6366F1" FontSize="13" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="LevelSlider"
                                        Minimum="0" Maximum="3" StepFrequency="1"
                                        Value="{x:Bind ViewModel.CompressionSpeedIndex, Mode=TwoWay}"
                                        TickFrequency="1" TickPlacement="Outside"/>
                            </StackPanel>

                            <ToggleSwitch Header="SHA-256 Checksums (integrity)"
                                          IsOn="{x:Bind ViewModel.HasChecksums, Mode=TwoWay}"
                                          Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Encryption options -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12"
                            BorderBrush="#E5E7EB" BorderThickness="1" Padding="24,20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Encryption"
                                       FontWeight="SemiBold" FontSize="15" Foreground="#1A1A2E"/>

                            <ToggleSwitch x:Name="EncryptToggle"
                                          Header="Enable AES-256 Encryption"
                                          IsOn="{x:Bind ViewModel.EnableEncryption, Mode=TwoWay}"/>

                            <StackPanel Spacing="12">
                                <PasswordBox x:Name="PasswordBox"
                                             PlaceholderText="Password"
                                             Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                                             CornerRadius="8"
                                             IsEnabled="{x:Bind ViewModel.EnableEncryption, Mode=OneWay}"/>
                                <TextBox PlaceholderText="Password hint (optional)"
                                         Text="{x:Bind ViewModel.PasswordHint, Mode=TwoWay}"
                                         CornerRadius="8"
                                         IsEnabled="{x:Bind ViewModel.EnableEncryption, Mode=OneWay}"/>
                                <ToggleSwitch Header="Encrypt filenames (fully opaque archive)"
                                              IsOn="{x:Bind ViewModel.EncryptFileNames, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.EnableEncryption, Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Split archive -->
                <Border Background="White" CornerRadius="12"
                        BorderBrush="#E5E7EB" BorderThickness="1" Padding="24,20">
                    <StackPanel Spacing="12">
                        <ToggleSwitch x:Name="SplitToggle"
                                      Header="Split Archive into Parts"
                                      IsOn="{x:Bind ViewModel.EnableSplit, Mode=TwoWay}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Part size:"
                                       VerticalAlignment="Center" Foreground="#4B5563"/>
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind ViewModel.SplitSizeMb, Mode=TwoWay}"
                                     InputScope="Number" CornerRadius="8"
                                     IsEnabled="{x:Bind ViewModel.EnableSplit, Mode=OneWay}"/>
                            <TextBlock Grid.Column="2" Text="MB"
                                       VerticalAlignment="Center" Foreground="#4B5563"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom action bar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                Padding="40,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <ProgressBar x:Name="CreateProgressBar"
                                 Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                                 Maximum="100" IsIndeterminate="False"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                                 CornerRadius="4" Height="8"/>
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                               Foreground="#6B7280" FontSize="13"
                               Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                               TextWrapping="Wrap"
                               MaxLines="2"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="#374151" FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="CreateButton"
                        Content="Create Archive"
                        Click="CreateArchive_Click"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegateConverter}}"
                        Style="{StaticResource AccentButtonStyle}"
                        CornerRadius="10"
                        Padding="28,12"
                        FontSize="15" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Page>
