<Page
    x:Class="KesFile.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PageBackgroundBrush}">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            IsPaneToggleButtonVisible="True"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="960"
            OpenPaneLength="240"
            IsSettingsVisible="True"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">

            <!-- Navigation items -->
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="home" Icon="Home" Content="Home"/>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Tag="create" Content="Create Archive">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="open" Content="Open Archive">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8DA;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Custom header in the pane -->
            <NavigationView.PaneHeader>
                <StackPanel Margin="16,12,16,8" Spacing="2">
                    <TextBlock Text="KIS file"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#5064D4"/>
                    <TextBlock Text="Secure Archive Manager"
                               FontSize="11" Foreground="#9CA3AF"/>
                </StackPanel>
            </NavigationView.PaneHeader>

            <!-- Content frame -->
            <Frame x:Name="ContentFrame"
                   Background="{StaticResource PageBackgroundBrush}"/>
        </NavigationView>
    </Grid>
</Page>
